# Supabase project credentials
# Create a project at https://supabase.com, then copy these from
# Project Settings > API. These are public (anon) values that are
# safe to bundle in a client app because RLS policies protect data.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
