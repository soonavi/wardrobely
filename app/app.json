{
  "expo": {
    "name": "Selv",
    "slug": "selv",
    "scheme": "selv",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F2EA"
    },
    "backgroundColor": "#F5F2EA",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selv.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.selv.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#141026"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Selv to access your photos so you can add garment images.",
          "cameraPermission": "Allow Selv to access your camera so you can photograph garments."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Selv to save your share card to your Photos.",
          "savePhotosPermission": "Allow Selv to save your share card to your Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
